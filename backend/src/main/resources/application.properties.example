# ============================================
# Vehicle Rental Platform - Unified Application Config
# Copy this file to application.properties and fill in your own values.
# application.properties is gitignored - NEVER commit real secrets.
# ============================================

server.port=8080
spring.application.name=vehicle-rental-platform

# ---------- MySQL ----------
# Run database/schema.sql first (or let Hibernate ddl-auto=update build it).
spring.datasource.url=jdbc:mysql://localhost:3306/sliit_vehicle_rental_db?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# ---------- JWT ----------
# Generate your own 256-bit secret, e.g.: openssl rand -base64 32
# This MUST be the same value across every teammate's local setup since the
# whole app shares one JWT signing secret.
app.jwt.secret=CHANGE_ME_GENERATE_YOUR_OWN_SECRET
app.jwt.expiration-ms=3600000
app.jwt.default-session-timeout-ms=1800000

# ---------- Mail (for MFA OTP emails) ----------
# Use a Gmail App Password, not your real Gmail password.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=CHANGE_ME@gmail.com
spring.mail.password=CHANGE_ME_APP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.mfa.otp-expiry-minutes=5
app.mfa.otp-length=6

# ---------- Backups ----------
app.backup.mysqldump-path=mysqldump
app.backup.output-dir=./backups
app.backup.cron=0 0 2 * * *
app.backup.db-name=sliit_vehicle_rental_db
app.backup.db-user=root
app.backup.db-password=CHANGE_ME

# ---------- File uploads (documents, vehicle/inspection images) ----------
app.upload.directory=./uploads
app.fleet.renewal-warning-days=30

# ---------- CORS ----------
app.cors.allowed-origins=http://localhost:5173

logging.level.com.sliit.vehiclerental=DEBUG
